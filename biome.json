{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "*.json",
      "*.ts",
      "src/**",
      "scripts/**",
      "packages/**",
      "crates/**/tests/**",
      "!**/src/ipc/bindings.ts",
      "!crates/extensions/schema",
      "!crates/worker/protocol",
      "!packages/plugin-api/index.d.ts",
      "!**/node_modules",
      "!**/target"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "assist": {
    "enabled": true
  }
}
